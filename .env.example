# Variáveis Supabase (obtidas no painel do projeto Supabase: Settings > API)
VITE_SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
VITE_SUPABASE_PROJECT_ID="SEU_PROJECT_ID"
VITE_SUPABASE_PUBLISHABLE_KEY="SUA_ANON_KEY"

# Edge functions (Deno Deploy — secrets configuradas no painel do deploy, nunca neste arquivo)
# SUPABASE_SERVICE_ROLE_KEY é definida como secret no painel da Supabase Edge Functions
